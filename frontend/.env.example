# =============================================================================
# ChauleClips — frontend environment template
# =============================================================================
# Copy to frontend/.env for local overrides (optional: the defaults below work).
#
# SECURITY: only put NON-SECRET values here. Every VITE_* variable is compiled
# into the JavaScript bundle and is readable by anyone using the app. API keys,
# database URLs and JWT secrets belong in backend/.env only.
# =============================================================================

# Where the API lives from the browser's point of view.
# Leave empty to use the Vite dev proxy (/api/v1 -> http://127.0.0.1:8000).
VITE_API_BASE_URL=/api/v1

# Shown in the UI so it is obvious which backend you are talking to.
VITE_APP_ENV=development

# FastAPI's interactive API docs. Served by the backend, so it is an absolute
# URL; the Settings page links here.
VITE_API_DOCS_URL=http://127.0.0.1:8000/docs
