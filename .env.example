# =============================================================================
# ChauleClips — top-level environment template
# =============================================================================
# The application does NOT read this file directly. It is a single place to see
# every setting; the real values live in two separate files:
#
#   backend/.env    -> FastAPI settings        (template: backend/.env.example)
#   frontend/.env   -> Vite settings           (template: frontend/.env.example)
#
# Never put an API key in frontend/.env — anything that starts with VITE_ is
# compiled into JavaScript and becomes public in the browser.
#
# Generate the local secrets with one of these:
#   Windows PowerShell : python -c "import secrets; print(secrets.token_urlsafe(48))"
#   macOS / Linux      : python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#
# -----------------------------------------------------------------------------
# Shared / scripts only (used by helper scripts in scripts/, not by the app)
# -----------------------------------------------------------------------------
MONGODB_URL=mongodb://127.0.0.1:27017
DATABASE_NAME=chauleclips
