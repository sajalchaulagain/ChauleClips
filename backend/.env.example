# =============================================================================
# ChauleClips — backend environment template
# =============================================================================
# Copy this file to backend/.env and fill in the values:
#   Windows PowerShell : Copy-Item .env.example .env
#   macOS / Linux      : cp .env.example .env
#
# NEVER commit backend/.env. It is already in .gitignore.
# Generate real secrets instead of keeping "CHANGE_ME":
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Legend: [required] = must be set for a real deployment
#         [optional] = has a safe default / feature simply stays disabled
# =============================================================================

# --- Application -------------------------------------------------------------
APP_NAME=ChauleClips
APP_ENV=development              # development | production | test
DEBUG=true
APP_VERSION=0.1.0

# --- Secrets -----------------------------------------------------------------
# [required] Signing key for cookies/session tokens. "CHANGE_ME" is rejected in
# production and reported as a setup warning in development.
SECRET_KEY=CHANGE_ME
# [required] Signing key for JWT access tokens. Use a different value.
JWT_SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Server ------------------------------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173
# Comma-separated list. Only these origins may call the API from a browser.
CORS_ORIGINS=http://localhost:5173

# --- Database ----------------------------------------------------------------
MONGODB_URL=mongodb://127.0.0.1:27017
DATABASE_NAME=chauleclips
MONGODB_TIMEOUT_MS=5000

# --- OpenRouter (AI analysis, Phase 5) ---------------------------------------
# [optional] Leave empty and the app still runs; AI features report that they
# need configuration instead of pretending to work.
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# "openrouter/free" lets OpenRouter pick an available free model.
OPENROUTER_MODEL=openrouter/free
# Comma-separated fallbacks tried in order if the primary model fails.
OPENROUTER_FALLBACK_MODELS=
OPENROUTER_TIMEOUT_SECONDS=120
OPENROUTER_MAX_RETRIES=2

# --- Storage & upload limits -------------------------------------------------
# Relative paths are resolved against the backend/ directory.
VIDEO_STORAGE_PATH=../storage
MAX_VIDEO_SIZE_MB=2048
MAX_VIDEO_DURATION_MINUTES=180

# --- Media tooling -----------------------------------------------------------
# Leave empty to use the FFmpeg found on PATH.
FFMPEG_BINARY=
FFPROBE_BINARY=
FFMPEG_TIMEOUT_SECONDS=1800

# --- Transcription (Phase 4) -------------------------------------------------
WHISPER_MODEL=base               # tiny | base | small | medium | large-v3
WHISPER_DEVICE=cpu               # cpu | cuda
WHISPER_COMPUTE_TYPE=int8        # int8 (CPU) | float16 (GPU)

# --- Optional account features ----------------------------------------------
# Kept off locally on purpose: no SMTP configuration is required to develop.
EMAIL_VERIFICATION_ENABLED=false
PASSWORD_RESET_ENABLED=false
